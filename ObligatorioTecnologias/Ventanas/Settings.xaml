<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ObligatorioTecnologias.Ventanas.Settings"
             Title="Configuración">
    <ScrollView>
        <VerticalStackLayout Padding="30,40,30,0" Spacing="20">
            <!-- Cabecera de perfil -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Frame HasShadow="False" Padding="0" CornerRadius="60" HeightRequest="120" WidthRequest="120" IsClippedToBounds="True" BackgroundColor="#EEE">
                    <Image x:Name="imgFotoPerfil"
                           HeightRequest="120"
                           WidthRequest="120"
                           Aspect="AspectFill"
                           Source="usuario_defecto.png"/>
                </Frame>
                <Label x:Name="lblNombreCompleto"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label x:Name="lblNombreUsuario"
                       FontSize="16"
                       TextColor="{DynamicResource Gray500}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <!-- Aquí puedes agregar más opciones de configuración -->
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>