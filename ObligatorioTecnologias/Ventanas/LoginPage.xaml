  <ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ObligatorioTecnologias.Ventanas.LoginPage"
             Title="Iniciar Sesión">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Entry x:Name="entryUsuario" Placeholder="Usuario" />
        <Entry x:Name="entryContrasena" Placeholder="Contraseña" IsPassword="True" />
        <Button Text="Iniciar Sesión" Clicked="OnLoginClicked"/>
        <Button Text="Registrarse" Clicked="OnRegisterClicked"/>
    </VerticalStackLayout>
</ContentPage>