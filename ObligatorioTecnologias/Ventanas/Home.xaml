<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ObligatorioTecnologias.Ventanas.Home"
             Title="Home">
    <VerticalStackLayout Padding="30" Spacing="20">
        <!-- Imagen superior (logo de la radio o lo que prefieras) -->
        <Image Source="fmlogo.png" HeightRequest="400" HorizontalOptions="Center"/>

        <Label Text="FM Punta" 
               FontFamily="Empty"
               FontSize="50" 
               FontAttributes="Bold"
               CharacterSpacing="3"
               HorizontalOptions="Center"
               TextColor="DarkCyan"/>

        <!-- Reproductor de audio embebido -->
        <WebView x:Name="webRadio" HeightRequest="80" WidthRequest="300" BackgroundColor="DarkGrey"/>

    </VerticalStackLayout>
</ContentPage>