<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ObligatorioTecnologias.Ventanas.Cine"
             Title="Próximos Estrenos">

    <VerticalStackLayout Padding="10" Spacing="10">

        <!-- Barra de búsqueda -->
        <HorizontalStackLayout Spacing="5">
            <Entry x:Name="BusquedaEntry"
                   Placeholder="Buscar por palabra clave o género"
                   HorizontalOptions="FillAndExpand"/>
            <Button Text="Buscar" Clicked="OnBuscarClicked"/>
        </HorizontalStackLayout>

        <!-- Listas -->
        <CollectionView x:Name="PeliculasCollection" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="LightGray" CornerRadius="8" Padding="10" Margin="0,5">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding title}" FontAttributes="Bold" FontSize="18"/>
                            <Image Source="{Binding poster_full_url}" Aspect="AspectFill" HeightRequest="200"/>
                            <Label Text="{Binding overview}" FontSize="14" LineBreakMode="WordWrap" MaxLines="5"/>
                            <Label Text="{Binding release_date}" FontAttributes="Italic" FontSize="12"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
